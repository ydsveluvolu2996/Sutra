# Sutra private origin reverse proxy.
#
# Environment (injected by the caddy service in compose.prod.yaml):
#   {$SUTRA_DOMAIN}      apex domain, e.g. sutracmdb.com  (default below)
#
# Behaviour:
#   * Plain HTTP on the Compose-only :8080 origin. Cloudflare Tunnel is the only
#     ingress path and Cloudflare terminates public TLS; EC2 publishes no ports.
#   * reverse_proxy -> app:3000. The upstream Host is the canonical public
#     hostname. Sutra runs its explicit staging/private-beta password boundary;
#     no loopback Host or Origin rewrite is used to bypass the network boundary.
#   * When app:3000 is stopped / down / unhealthy, handle_errors serves the
#     static maintenance page with HTTP 503 instead of a raw 502/504.
{
	auto_https off
	admin off
}

:8080 {
	encode zstd gzip

	# This endpoint is reachable only from Caddy's own loopback socket. Tunnel
	# requests for the same path do not match and continue to the application.
	@container_health {
		path /caddy-healthz
		remote_ip 127.0.0.1 ::1
	}
	respond @container_health "ok" 200

	# Only the WAF-protected tunnel origin is accepted. Local loopback probes
	# remain exempt; no Docker port is published to the EC2 host.
	@unexpected_tunnel_host {
		not host origin.{$SUTRA_DOMAIN:sutracmdb.com}
		not remote_ip 127.0.0.1 ::1
	}
	respond @unexpected_tunnel_host "Misdirected request" 421

	# Start HSTS with a short, reversible pilot window. Raise it only after every
	# subdomain has been reviewed; do not preload a private-beta deployment.
	header {
		Strict-Transport-Security "max-age=300"
		-Server
	}

	# Automatic maintenance page. Triggered by handle_errors whenever the
	# reverse_proxy below cannot get a usable response from the app (connection
	# refused when stopped, or a health-gated failure). Served as 503 so crawlers
	# and monitors treat it as a temporary outage, not a hard error.
	handle_errors {
		root * /srv/maintenance
		rewrite * /maintenance.html
		file_server {
			status 503
		}
		header {
			Content-Type "text/html; charset=utf-8"
			Cache-Control "no-store"
			Retry-After "120"
		}
	}

	reverse_proxy app:3000 {
		# Preserve the real browser origin for the explicit private-beta boundary
		# and same-origin mutation checks.
		header_up Host www.{$SUTRA_DOMAIN:sutracmdb.com}

		# Trust boundary: :8080 is never published by Docker and is reachable from
		# the tunnel/application bridges only. `cloudflared` is therefore the sole
		# external ingress and its CF-Connecting-IP is authoritative. If a host port
		# is ever added, this assumption becomes false and this mapping MUST be
		# replaced by an allowlisted-proxy policy before deployment.
		header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
		# The public browser/API connection is always HTTPS at Cloudflare even though
		# the private cloudflared -> Caddy hop is intentionally plain HTTP.
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host www.{$SUTRA_DOMAIN:sutracmdb.com}

		# Do not expose multiple competing client-identity inputs to application
		# code after canonicalizing X-Forwarded-For above.
		header_up -CF-Connecting-IP
		header_up -True-Client-IP
		# Cloudflare identity headers are not part of Sutra's application protocol;
		# remove any client-supplied values before the request reaches the app.
		header_up -CF-Access-Client-Id
		header_up -CF-Access-Client-Secret
		header_up -CF-Access-Jwt-Assertion

		# Active health gating: if the app reports unhealthy, mark the upstream
		# down so requests fall through to handle_errors (the maintenance page).
		# The probe carries the canonical Host expected by the private-beta
		# deployment boundary.
		health_uri /api/healthz
		health_interval 10s
		health_timeout 5s
		health_status 2xx
		health_headers {
			Host www.{$SUTRA_DOMAIN:sutracmdb.com}
			X-Forwarded-Proto https
		}

		# Fail fast to the maintenance page rather than hanging on a dead upstream.
		lb_try_duration 3s
	}
}
