# Local pilot configuration. Run `npm run pilot:setup` to generate real local
# secrets in ignored `.dev.vars`; do not copy example values into production.
SUTRA_DEPLOYMENT_ENV=local
SUTRA_LOCAL_MODE=true
# Hosted staging/production replaces local auth with a reviewed OIDC provider
# and stores the provider secret and transaction key as managed secrets.
# SUTRA_IDENTITY_MODE=oidc
# SUTRA_PUBLIC_ORIGIN=https://app.sutracmdb.com
# India-region Zoho OIDC provider. Register the redirect URI
# https://app.sutracmdb.com/api/auth/oidc/callback in the Zoho API Console.
# Keep the entire provider JSON in managed runtime configuration because it
# contains the confidential client secret.
# SUTRA_OIDC_PROVIDERS=[{"id":"zoho","issuer":"https://accounts.zoho.in","authorizationEndpoint":"https://accounts.zoho.in/oauth/v2/auth","tokenEndpoint":"https://accounts.zoho.in/oauth/v2/token","jwksUri":"https://accounts.zoho.in/oauth/v2/keys","clientId":"<zoho-client-id>","clientSecret":"<managed-zoho-client-secret>"}]
# SUTRA_OIDC_TRANSACTION_KEY=<base64url-encoded-32-byte-managed-secret>
# An approved, invitation-only single-host pilot uses a separate STAGING-ONLY
# password gate. Pass this exact allowlist to setup-local-pilot through the
# container environment; do not add the production password switch.
# SUTRA_DEPLOYMENT_ENV=staging
# SUTRA_PUBLIC_ORIGIN=https://www.sutracmdb.com
# SUTRA_LOCAL_MODE=false
# SUTRA_IDENTITY_MODE=password
# SUTRA_PASSWORD_MFA_REQUIRED=true
# SUTRA_PRIVATE_BETA_PASSWORD_ENABLED=true
SUTRA_LOCAL_BOOTSTRAP_TOKEN=<base64url-encoded-32-byte-token>
SUTRA_AUTH_ENCRYPTION_KEY=<different-base64url-encoded-32-byte-key>
SUTRA_AUTH_KEY_VERSION=local-auth-v1
SUTRA_CONNECTION_ENCRYPTION_KEY=<base64url-encoded-32-byte-key>
SUTRA_CONNECTION_KEY_VERSION=local-v1
SUTRA_BROKER_SHARED_SECRET=<base64url-encoded-32-byte-key>
SUTRA_REGISTRY_ENCRYPTION_KEY=<different-base64url-encoded-32-byte-key>
SUTRA_BROKER_URL=http://127.0.0.1:8788
SUTRA_COLLECTOR_MODE=fixture
SUTRA_ALLOW_LIVE_AWS=false
SUTRA_COLLECTOR_PRINCIPAL_ARN=arn:aws:iam::999988887777:role/SutraLocalCollector
# Optional non-secret regional S3 URL for the reviewed customer-role template.
# The path must include the exact reviewed version and SHA-256 and the URL must
# pin a non-null S3 versionId. Leave empty for the manual upload fallback.
SUTRA_CUSTOMER_ROLE_TEMPLATE_URL=
SUTRA_FIXTURE_ACCOUNT_ID=123456789012
SUTRA_REGISTRY_PATH=.sutra/collector-registry.enc

# Public unauthenticated mutation protection (login, contact, invitation
# acceptance). A network deployment MUST use a real Managed Turnstile widget
# restricted to its canonical hostname. The site key is public; the secret key
# belongs only in ignored/managed runtime secrets.
# SUTRA_TURNSTILE_ENABLED=true
# SUTRA_TURNSTILE_SITE_KEY=<cloudflare-turnstile-site-key>
# SUTRA_TURNSTILE_SECRET_KEY=<managed-secret>
# SUTRA_TURNSTILE_DEV_BYPASS=false
#
# `pilot:setup` writes this explicit bypass for loopback-only development. The
# server rejects it outside SUTRA_DEPLOYMENT_ENV=local + SUTRA_LOCAL_MODE=true.
SUTRA_TURNSTILE_DEV_BYPASS=true

# Public contact routing. The addresses are real Zoho aliases; delivery still
# requires the OAuth configuration below.
SUTRA_CONTACT_RECIPIENT=contact@sutracmdb.com
SUTRA_CONTACT_FROM=Sutra Contact <contact@sutracmdb.com>
# SUTRA_CONTACT_PROVIDER=zoho

# Transactional email for invitations and password resets.
SUTRA_INVITATION_FROM=Sutra Support <support@sutracmdb.com>
# SUTRA_INVITATION_EMAIL_PROVIDER=zoho

# Shared Zoho Mail REST API credentials for contact, invitations, password
# resets, and scheduled reports. Generate a refresh token with the minimum
# ZohoMail.messages.CREATE scope and keep every credential in ignored/managed
# runtime configuration. The account id is the primary mailbox account id.
# SUTRA_ZOHO_DATACENTER=in
# SUTRA_ZOHO_MAIL_ACCOUNT_ID=<numeric-account-id>
# SUTRA_ZOHO_CLIENT_ID=<zoho-mail-client-id>
# SUTRA_ZOHO_CLIENT_SECRET=<managed-secret>
# SUTRA_ZOHO_REFRESH_TOKEN=<managed-refresh-token>

# Alternative HTTPS transactional-email provider:
# SUTRA_CONTACT_PROVIDER=resend
# SUTRA_CONTACT_EMAIL_API_URL=https://api.resend.com/emails
# SUTRA_CONTACT_EMAIL_API_KEY=<managed-secret>
# SUTRA_INVITATION_EMAIL_PROVIDER=resend
# SUTRA_INVITATION_EMAIL_API_URL=https://api.resend.com/emails
# SUTRA_INVITATION_EMAIL_API_KEY=<managed-secret>

# Optional local PostgreSQL adapter. `pnpm docker:up` generates and wires a
# high-entropy credential automatically; do not commit a real DATABASE_URL.
DATABASE_URL=postgresql://sutra_app:<generated-runtime-password>@127.0.0.1:54329/sutra

# Live mode is denied unless SUTRA_ALLOW_LIVE_AWS=true is separately set for an
# explicitly authorized disposable sandbox. It then uses the AWS SDK default
# credential provider chain. Configure a short-lived profile or workload
# identity outside this file. Never store AWS access keys or session tokens here.
