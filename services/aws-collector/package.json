{
  "name": "@msp/aws-collector",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "preflight:live": "pnpm run build && node dist/src/aws-sandbox-preflight.js",
    "test": "pnpm run clean && pnpm run build && node --test dist/test/**/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prebuild": "pnpm --dir ../agentless-scanner build"
  },
  "dependencies": {
    "@aws-sdk/client-cloudtrail": "3.1087.0",
    "@aws-sdk/client-cloudwatch": "3.1087.0",
    "@aws-sdk/client-cost-explorer": "3.1087.0",
    "@aws-sdk/client-dynamodb": "3.1087.0",
    "@aws-sdk/client-ec2": "3.1087.0",
    "@aws-sdk/client-ecr": "3.1087.0",
    "@aws-sdk/client-eks": "3.1087.0",
    "@aws-sdk/client-elastic-load-balancing-v2": "3.1087.0",
    "@aws-sdk/client-guardduty": "3.1087.0",
    "@aws-sdk/client-iam": "3.1087.0",
    "@aws-sdk/client-inspector2": "3.1087.0",
    "@aws-sdk/client-kms": "3.1087.0",
    "@aws-sdk/client-rds": "3.1087.0",
    "@aws-sdk/client-s3": "3.1087.0",
    "@aws-sdk/client-securityhub": "3.1087.0",
    "@aws-sdk/client-ssm": "3.1087.0",
    "@aws-sdk/client-sts": "3.1087.0",
    "@msp/agentless-scanner": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "typescript": "5.9.3"
  }
}
