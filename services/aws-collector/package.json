{
  "name": "@msp/aws-collector",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "preflight:live": "pnpm run build && node dist/src/aws-sandbox-preflight.js",
