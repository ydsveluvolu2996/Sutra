{
  "name": "sutra",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "dev:pilot": "node scripts/dev-pilot.mjs",
    "pilot:setup": "node scripts/setup-local-pilot.mjs",
    "pilot:reset": "node scripts/reset-local-pilot.mjs",
    "local:backup": "node scripts/local-backup.mjs",
    "local:restore": "node scripts/local-restore.mjs",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "node --test tests/security-controls.test.ts tests/aws-pilot-security.test.ts tests/pilot-boundary.test.ts tests/local-auth.test.ts tests/local-data-backup.test.mjs",
    "test:collector": "pnpm --dir services/aws-collector test",
    "test:rendered": "node --test tests/rendered-html.test.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:collector": "pnpm --dir services/aws-collector typecheck",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "verify": "pnpm typecheck && pnpm typecheck:collector && pnpm lint && pnpm test && pnpm test:collector && pnpm build && pnpm test:rendered"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
