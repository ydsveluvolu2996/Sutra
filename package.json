{
  "name": "sutra",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "dev:pilot": "node scripts/dev-pilot.mjs",
    "start:pilot": "node scripts/start-pilot.mjs",
    "live:aws:prepare": "node scripts/prepare-live-aws.mjs",
    "live:aws:publish-template": "node scripts/publish-onboarding-template.mjs",
    "live:aws:host": "node scripts/live-aws-host.mjs",
    "pilot:setup": "node scripts/setup-local-pilot.mjs",
    "pilot:reset": "node scripts/reset-local-pilot.mjs",
    "local:bootstrap-token": "node scripts/show-local-bootstrap-token.mjs",
    "local:backup": "node scripts/local-backup.mjs",
    "local:restore": "node scripts/local-restore.mjs",
    "docker:up": "node scripts/docker-local.mjs up",
    "docker:down": "node scripts/docker-local.mjs down",
    "docker:logs": "node scripts/docker-local.mjs logs",
    "db:postgres:migrate": "node scripts/postgres-migrate.mjs",
    "db:postgres:test": "node scripts/test-postgres.mjs",
    "db:postgres:backup": "node scripts/postgres-backup.mjs",
    "db:postgres:restore": "node scripts/postgres-restore.mjs",
    "db:postgres:reset": "node scripts/postgres-reset.mjs",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "security:secrets": "node scripts/check-repository-secrets.mjs",
    "test:templates": "node --test tests/aws-template-contract.test.mjs",
    "test:live-aws-host": "node --test tests/live-aws-host-launcher.test.mjs",
    "test": "node --test tests/security-controls.test.ts tests/compliance-engine.test.ts tests/cost-boundary.test.ts tests/portfolio-presentation.test.ts tests/aws-pilot-security.test.ts tests/pilot-boundary.test.ts tests/local-auth.test.ts tests/cmdb-change-history.test.ts tests/canonical-json.test.ts tests/local-operations.test.ts tests/local-operations-repository.test.mjs tests/local-schedule-outbox.test.mjs tests/local-data-backup.test.mjs tests/postgres-adapter.test.ts tests/postgres-schema-parity.test.mjs tests/aws-template-contract.test.mjs tests/aws-cloudformation-quick-launch.test.ts tests/live-aws-host-launcher.test.mjs tests/prepare-live-aws.test.mjs tests/publish-onboarding-template.test.mjs tests/docker-runtime-isolation.test.mjs tests/mfa-step-up-repository.test.mjs tests/finding-workflow-boundary.test.mjs",
    "test:collector": "pnpm --dir services/aws-collector test",
    "test:rendered": "node --test tests/rendered-html.test.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:collector": "pnpm --dir services/aws-collector typecheck",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "verify": "pnpm security:secrets && pnpm typecheck && pnpm typecheck:collector && pnpm lint && pnpm test && pnpm test:collector && pnpm db:postgres:test && pnpm build && pnpm test:rendered"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "pg": "8.22.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "miniflare": "4.20260515.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
